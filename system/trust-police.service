[Unit]
Description=Trust Platform - Police & Forensics Service
After=trust-firstresponder.service
Wants=trust-firstresponder.service

[Service]
Type=simple
User=trust
Group=trust
WorkingDirectory=/opt/trust/modules/police
ExecStart=/usr/bin/python3 /opt/trust/modules/police/police_service.py
Restart=always
RestartSec=3s

# Process Environment
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
