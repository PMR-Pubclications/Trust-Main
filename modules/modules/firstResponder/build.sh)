#!/usr/bin/env bash
# ==============================================================================
# Trust-Main: First Responder Module Build & Compilation Script
# Builds native hardware wrappers, installs dependencies, and generates reports.
# ==============================================================================

set -e

echo "--------------------------------------------------"
echo "[FIRST RESPONDER BUILD] Initializing Hardware Streaming Service Build..."
echo "--------------------------------------------------"

# Step 1: Install Python Requirements & Setup Native Wrappers (pyboson)
if [ -f "setup.py" ]; then
    echo "[FR BUILD STEP 1/3] Building and installing local setup package..."
    python3 setup.py build_ext --inplace --quiet
fi

if [ -f "requirements.txt" ]; then
    echo "[FR BUILD STEP 2/3] Installing Python dependencies..."
    python3 -m pip install -r requirements.txt --quiet
else
    echo "[FR BUILD STEP 2/3] No requirements.txt found. Skipping."
fi

# Step 2: Compile Local First Responder Telemetry Impact Report
echo "[FR BUILD STEP 3/3] Compiling hardware telemetry and TEE attestation report..."
python3 first_responder_compiler.py

echo "--------------------------------------------------"
echo "[FIRST RESPONDER BUILD SUCCESS] Hardware streaming module build complete. Report generated."
echo "--------------------------------------------------"
