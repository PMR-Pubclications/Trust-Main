{
  "name": "Trust-Main (Linux, Python tooling)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/Trust-Main",
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.debugpy"]
    }
  },
  "postStartCommand": "python asset/py/voice_commands.py --command 'list scripts'"
}
