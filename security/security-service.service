[Unit]
Description=Security policy validation and health service
After=network.target

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=-/etc/default/security-service
ExecStart=/opt/security-service/security-service.pyz
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
