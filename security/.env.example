# security/.env.example
#
# Copy this file to `.env` in the security/ directory and fill in real
# values for your deployment. NEVER commit the resulting `.env` file.
# This file must only ever contain placeholders — no real credentials,
# private keys, tokens, or biometric templates.

# Port the standalone security service listens on inside the container.
SECURITY_PORT=3100

# Node environment
NODE_ENV=production

# Shared admin key placeholder for any future admin-gated endpoints.
# Generate a real value with: openssl rand -hex 32
SECURITY_ADMIN_KEY=changeme-replace-with-a-generated-secret

# Base directory (inside the container) for non-biometric audit/ledger
# data written by the voice telemetry stub. Biometric templates, raw
# audio, or camera frames must never be written here.
SECURITY_DATA_DIR=/app/data

# Rate limiting for the voice-token telemetry endpoint (/api/v1/trust).
SECURITY_RATE_LIMIT_WINDOW_MS=60000
SECURITY_RATE_LIMIT_MAX_REQUESTS=30

